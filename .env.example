REWEAR_LLM_BASE_URL=https://api.deepseek.com
REWEAR_LLM_API_KEY=
# Models selected from REWEAR's offline and sealed evaluation; comma-separated primary,backup (max 5 per Agent).
REWEAR_MODEL_MAIN=deepseek-flash
REWEAR_MODEL_ITEM=qwen3.5-plus-2026-02-15
REWEAR_MODEL_REFERENCE=kimi-k2.6
REWEAR_MODEL_STYLIST=qwen3.5-plus-2026-02-15
REWEAR_MODEL_WARDROBE=deepseek-flash
REWEAR_MODEL_REVIEW=deepseek-flash
# An explicit per-Agent endpoint requires its own key; shared secrets never cross providers.
REWEAR_LLM_ITEM_BASE_URL=
REWEAR_LLM_ITEM_API_KEY=
REWEAR_LLM_REFERENCE_BASE_URL=https://api.moonshot.cn/v1
REWEAR_LLM_REFERENCE_API_KEY=
REWEAR_LLM_STYLIST_BASE_URL=
REWEAR_LLM_STYLIST_API_KEY=
# Optional compatibility with the previous shared-model configuration.
REWEAR_LLM_MODEL=
REWEAR_LLM_VISION_MODEL=
# Default: direct model API + explicit rule fallback. Set coze only for legacy migration.
REWEAR_AI_PROVIDER=direct
COZE_ANALYZE_BASE_URL=
COZE_ANALYZE_TOKEN=
COZE_STYLIST_BASE_URL=
COZE_STYLIST_TOKEN=
HOST=127.0.0.1
PORT=4174
# Public deployments must set an HTTPS origin and use persistent storage.
PUBLIC_ORIGIN=
DATA_DIR=storage
AI_USER_DAILY_LIMIT=12
AI_GLOBAL_DAILY_LIMIT=60
